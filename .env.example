# GEMINI_API_KEY: Server-only API key for Gemini AI calls.
# AI Studio automatically injects this at runtime from user secrets.
# NEVER prefix with VITE_ or expose to client-side code.
GEMINI_API_KEY=""

# APP_URL: The canonical URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=""

# ALLOWED_ORIGINS: Optional comma-separated list of additional trusted CORS origins.
ALLOWED_ORIGINS="https://nafisnoor.site,https://www.nafisnoor.site"

# Dedicated Admin Authentication Password & Session Signing Secret (Server-side only)
# Never hardcode in source files. Configure via AI Studio Secrets panel.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
ADMIN_EMAILS="alnoorgroup.n@gmail.com"

# SMTP Configuration for Password Reset & Verification Emails (Server-side only)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="nafisnoor.support@gmail.com"
SMTP_PASS=""
SMTP_FROM="Nafis Noor <nafisnoor.support@gmail.com>"
OTP_HMAC_SECRET=""

